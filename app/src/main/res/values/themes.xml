<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VisionPaint" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vp_accent</item>
        <item name="colorPrimaryDark">@color/vp_bg</item>
        <item name="colorAccent">@color/vp_accent</item>
        <item name="android:windowBackground">@color/vp_bg</item>
        <item name="android:statusBarColor">@color/vp_bg</item>
        <item name="android:navigationBarColor">@color/vp_bg</item>
        <item name="alertDialogTheme">@style/Theme.VisionPaint.Dialog</item>
    </style>

    <style name="Theme.VisionPaint.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/vp_accent_text</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>
</resources>
